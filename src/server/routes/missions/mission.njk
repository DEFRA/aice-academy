{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/character-count/macro.njk" import govukCharacterCount %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorList %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorList
        }) }}
      {% endif %}

      <span class="govuk-caption-l">{{ caption }}</span>
      <h1 class="govuk-heading-xl govuk-!-margin-bottom-4">{{ heading }}</h1>

      <p class="govuk-body app-mission-meta" data-testid="app-mission-meta">
        {{ mission.time }} · Badge: <strong>{{ mission.badge }}</strong>
        {% if isCompleted %}
          {{ govukTag({ text: "Completed", classes: "govuk-tag--green app-mission-meta__tag" }) }}
        {% endif %}
      </p>

      {% if leadTrack %}
        {{ govukInsetText({
          html: "<p class=\"govuk-body\">This is one of the missions you lead, because of the kind of work you do.</p><p class=\"govuk-body\">Your extra challenge: " + (leadTrack.stretch | escape) + "</p>"
        }) }}
      {% endif %}

      <div data-testid="app-mission-body">
        {{ mission.html | safe }}
      </div>

      {% if mission.setup %}
        <div id="setup" class="app-setup" data-testid="app-setup">
          {{ govukButton({
            text: setupCallToAction.text,
            href: setupCallToAction.href,
            isStartButton: not setupCallToAction.isFinished
          }) }}
        </div>
      {% endif %}

      {% set stuckHtml %}
        {% if stuck.length %}
          <dl class="app-stuck">
            {% for item in stuck %}
              <dt class="govuk-heading-s app-stuck__problem">{{ item.problem }}</dt>
              <dd class="app-stuck__fix">{{ item.fixHtml | safe }}</dd>
            {% endfor %}
          </dl>
        {% endif %}
        <p class="govuk-body"><strong>Still stuck?</strong> Ask Claude: "I'm stuck. What should I check?" Or type <code class="app-code">/explain</code> to have Claude explain what just happened. You can also ask in your cohort channel. Everyone gets stuck sometimes.</p>
      {% endset %}

      {{ govukDetails({
        summaryText: "I'm stuck",
        html: stuckHtml,
        attributes: { "data-testid": "app-stuck" }
      }) }}

      <form action="/missions/{{ mission.slug }}" method="post" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">

        {{ govukCheckboxes(checks) }}

        {{ govukCharacterCount(reflection) }}

        {{ govukButton({
          text: "Save changes" if isCompleted else "Mark mission as complete"
        }) }}
      </form>

      {{ govukPagination(pagination) }}
    </div>
  </div>
{% endblock %}
