{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/task-list/macro.njk" import govukTaskList %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: "AICE Academy"
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if hasGraduated %}
        {{ govukPanel({
          titleText: "You've graduated",
          html: "You're an <strong>AI-native builder</strong>"
        }) }}
      {% else %}
        <div class="app-next" data-testid="app-next">
          <p class="govuk-body govuk-!-margin-bottom-2">{{ "Up next" if hasStarted else "Start here" }}</p>
          <h2 class="govuk-heading-m govuk-!-margin-bottom-2">Mission {{ nextMission.number }}: {{ nextMission.title }}</h2>
          <p class="govuk-body">{{ nextMission.summary }} {{ nextMission.time }}.</p>
          {{ govukButton({
            text: ("Continue" if hasStarted else "Start") + " Mission " + nextMission.number,
            href: "/missions/" + nextMission.slug,
            classes: "govuk-!-margin-bottom-0"
          }) }}
        </div>
      {% endif %}

      <p class="govuk-body" data-testid="app-progress">You have completed {{ completedCount }} of {{ missionCount }} missions.</p>

      {% if profession %}
        <p class="govuk-body" data-testid="app-track">
          Your work: <strong>{{ profession.name }}</strong>.
          <a href="/profession" class="govuk-link">Change<span class="govuk-visually-hidden"> the kind of work you do</span></a>
        </p>
      {% endif %}

      {% if badges.length %}
        <h2 class="govuk-heading-s">Badges earned</h2>
        <ul class="govuk-list app-badges" data-testid="app-badges">
          {% for badge in badges %}
            <li class="app-badges__item">{{ govukTag({ text: badge, classes: "govuk-tag--green" }) }}</li>
          {% endfor %}
        </ul>
      {% endif %}

      {% for stage in stages %}
        <h2 class="govuk-heading-m app-stage-heading" id="stage-{{ stage.id }}">Stage {{ loop.index }}: {{ stage.name }}</h2>
        {{ govukTaskList({
          idPrefix: "missions-" + stage.id,
          items: stage.items
        }) }}
      {% endfor %}
    </div>
  </div>
{% endblock %}
